{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/moraph-com/regulated-workflow-schemas/v0.1.0/schemas/permit-application.schema.json",
  "title": "Permit application",
  "description": "An application for a building, land-use or other local-government permit, from submission through plan review, fees, inspections and decision, including the statutory review clock. Informed by common local-government permitting practice and the Building and Land Development Specification (BLDS); the docs map fields to BLDS where they correspond.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "recordType",
    "schemaVersion",
    "id",
    "jurisdiction",
    "permitType",
    "applicant",
    "site",
    "status"
  ],
  "properties": {
    "$schema": {
      "title": "Schema",
      "description": "The $id of this schema, so readers can tell what the record is.",
      "type": "string",
      "format": "uri"
    },
    "recordType": {
      "title": "Record type",
      "description": "Always permit-application.",
      "const": "permit-application"
    },
    "schemaVersion": {
      "title": "Schema version",
      "description": "The version of this format the record follows.",
      "const": "0.1.0"
    },
    "id": {
      "$ref": "common.schema.json#/$defs/identifier",
      "description": "This application's identifier, unique within the system that created it."
    },
    "externalIds": {
      "title": "External identifiers",
      "description": "Ids for this application in other systems, for example the jurisdiction's permitting system.",
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/externalId"
      }
    },
    "createdAt": {
      "$ref": "common.schema.json#/$defs/dateTime",
      "description": "When the record was created."
    },
    "updatedAt": {
      "$ref": "common.schema.json#/$defs/dateTime",
      "description": "When the record was last changed."
    },
    "jurisdiction": {
      "$ref": "common.schema.json#/$defs/jurisdiction",
      "description": "The jurisdiction whose permit is sought."
    },
    "permitType": {
      "title": "Permit type",
      "description": "What kind of permit is sought.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "category"
      ],
      "properties": {
        "category": {
          "title": "Category",
          "description": "building, demolition, electrical, mechanical, plumbing, fire, grading, right-of-way, sign, zoning, land-use, environmental, special-event or other.",
          "type": "string",
          "enum": [
            "building",
            "demolition",
            "electrical",
            "mechanical",
            "plumbing",
            "fire",
            "grading",
            "right-of-way",
            "sign",
            "zoning",
            "land-use",
            "environmental",
            "special-event",
            "other"
          ]
        },
        "subtype": {
          "title": "Subtype",
          "description": "The jurisdiction's own permit type name, for example Residential Addition.",
          "type": "string",
          "maxLength": 200
        },
        "workClass": {
          "title": "Work class",
          "description": "new, addition, alteration, repair, demolition, change-of-use or other.",
          "type": "string",
          "enum": [
            "new",
            "addition",
            "alteration",
            "repair",
            "demolition",
            "change-of-use",
            "other"
          ]
        },
        "residential": {
          "title": "Residential",
          "description": "Whether the work is residential (true) or commercial and other (false).",
          "type": "boolean"
        }
      }
    },
    "description": {
      "title": "Description of work",
      "description": "What the applicant proposes to do.",
      "type": "string",
      "maxLength": 8000
    },
    "valuation": {
      "$ref": "common.schema.json#/$defs/money",
      "description": "Declared value of the work."
    },
    "applicant": {
      "$ref": "#/$defs/party",
      "description": "Who is applying."
    },
    "parties": {
      "title": "Other parties",
      "description": "Owners, contractors, design professionals and agents on the application besides the applicant.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/party"
      }
    },
    "site": {
      "title": "Site",
      "description": "Where the work will happen.",
      "type": "object",
      "additionalProperties": false,
      "anyOf": [
        {
          "required": [
            "parcelNumber"
          ]
        },
        {
          "required": [
            "address"
          ]
        },
        {
          "required": [
            "location"
          ]
        }
      ],
      "properties": {
        "parcelNumber": {
          "title": "Parcel number",
          "description": "The assessor's parcel number (APN) or equivalent land identifier.",
          "type": "string",
          "maxLength": 100
        },
        "address": {
          "$ref": "common.schema.json#/$defs/address",
          "description": "The site's street address."
        },
        "location": {
          "$ref": "common.schema.json#/$defs/geoPoint",
          "description": "The site's coordinates."
        },
        "zoning": {
          "title": "Zoning",
          "description": "The parcel's zoning designation, as the jurisdiction writes it.",
          "type": "string",
          "maxLength": 100
        },
        "floodZone": {
          "title": "Flood zone",
          "description": "The flood hazard zone, if mapped, for example AE.",
          "type": "string",
          "maxLength": 50
        },
        "historicDistrict": {
          "title": "Historic district",
          "description": "Whether the site is in a designated historic district.",
          "type": "boolean"
        }
      }
    },
    "building": {
      "title": "Building",
      "description": "Facts about the building or structure, for building permits.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "occupancyGroup": {
          "title": "Occupancy group",
          "description": "The building code occupancy classification, for example R-3 or B.",
          "type": "string",
          "maxLength": 20
        },
        "constructionType": {
          "title": "Construction type",
          "description": "The building code construction type, for example V-B.",
          "type": "string",
          "maxLength": 20
        },
        "stories": {
          "title": "Stories",
          "description": "Number of stories above grade.",
          "type": "integer",
          "minimum": 0
        },
        "dwellingUnits": {
          "title": "Dwelling units",
          "description": "Dwelling units added (negative when removed).",
          "type": "integer"
        },
        "area": {
          "title": "Area",
          "description": "Floor area affected by the work.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "value",
            "unit"
          ],
          "properties": {
            "value": {
              "title": "Value",
              "description": "The area.",
              "type": "number",
              "minimum": 0
            },
            "unit": {
              "title": "Unit",
              "description": "sq-ft or sq-m.",
              "type": "string",
              "enum": [
                "sq-ft",
                "sq-m"
              ]
            }
          }
        }
      }
    },
    "submittedAt": {
      "$ref": "common.schema.json#/$defs/dateTime",
      "description": "When it was submitted."
    },
    "documents": {
      "title": "Submitted documents",
      "description": "Plans and documents submitted with the application. Each points at an entry in attachments.",
      "type": "array",
      "items": {
        "title": "Submitted document",
        "description": "One submitted document.",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "attachmentId",
          "kind"
        ],
        "properties": {
          "attachmentId": {
            "$ref": "common.schema.json#/$defs/identifier",
            "description": "The id of the file in the record's attachments."
          },
          "kind": {
            "title": "Kind",
            "description": "site-plan, architectural-plans, structural-calculations, energy-compliance, mechanical-electrical-plumbing-plans, survey, photographs, owner-authorization, contractor-license, insurance-certificate, environmental-review or other.",
            "type": "string",
            "enum": [
              "site-plan",
              "architectural-plans",
              "structural-calculations",
              "energy-compliance",
              "mechanical-electrical-plumbing-plans",
              "survey",
              "photographs",
              "owner-authorization",
              "contractor-license",
              "insurance-certificate",
              "environmental-review",
              "other"
            ]
          },
          "revision": {
            "title": "Revision",
            "description": "Revision number or label, for example 2 or Rev B.",
            "type": "string",
            "maxLength": 50
          },
          "submittedAt": {
            "$ref": "common.schema.json#/$defs/dateTime",
            "description": "When it was submitted."
          }
        }
      }
    },
    "fees": {
      "title": "Fees",
      "description": "Fees assessed on the application.",
      "type": "array",
      "items": {
        "title": "Fee",
        "description": "One fee line.",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "description",
          "amount",
          "status"
        ],
        "properties": {
          "code": {
            "title": "Code",
            "description": "The jurisdiction's fee code.",
            "type": "string",
            "maxLength": 50
          },
          "description": {
            "title": "Description",
            "description": "What the fee is for.",
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "amount": {
            "$ref": "common.schema.json#/$defs/money",
            "description": "The fee amount."
          },
          "status": {
            "title": "Status",
            "description": "assessed, invoiced, paid, waived or refunded.",
            "type": "string",
            "enum": [
              "assessed",
              "invoiced",
              "paid",
              "waived",
              "refunded"
            ]
          },
          "paidAt": {
            "$ref": "common.schema.json#/$defs/dateTime",
            "description": "When it was paid."
          },
          "receipt": {
            "title": "Receipt",
            "description": "The receipt or transaction reference.",
            "type": "string",
            "maxLength": 100
          }
        }
      }
    },
    "reviews": {
      "title": "Plan reviews",
      "description": "Reviews by each discipline, one entry per discipline per review cycle.",
      "type": "array",
      "items": {
        "title": "Plan review",
        "description": "One discipline's review in one cycle.",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "discipline",
          "cycle"
        ],
        "properties": {
          "discipline": {
            "title": "Discipline",
            "description": "zoning, building, structural, fire, electrical, mechanical, plumbing, civil-engineering, environmental, health, historic-preservation, transportation, utilities or other.",
            "type": "string",
            "enum": [
              "zoning",
              "building",
              "structural",
              "fire",
              "electrical",
              "mechanical",
              "plumbing",
              "civil-engineering",
              "environmental",
              "health",
              "historic-preservation",
              "transportation",
              "utilities",
              "other"
            ]
          },
          "cycle": {
            "title": "Cycle",
            "description": "The review cycle, starting at 1; resubmissions start a new cycle.",
            "type": "integer",
            "minimum": 1
          },
          "reviewer": {
            "$ref": "common.schema.json#/$defs/personRef",
            "description": "Who reviewed."
          },
          "startedAt": {
            "$ref": "common.schema.json#/$defs/dateTime",
            "description": "When it started."
          },
          "completedAt": {
            "$ref": "common.schema.json#/$defs/dateTime",
            "description": "When it was completed."
          },
          "outcome": {
            "title": "Outcome",
            "description": "approved, approved-with-conditions, corrections-required, denied or not-applicable.",
            "type": "string",
            "enum": [
              "approved",
              "approved-with-conditions",
              "corrections-required",
              "denied",
              "not-applicable"
            ]
          },
          "comments": {
            "title": "Comments",
            "description": "Review comments the applicant must address.",
            "type": "array",
            "items": {
              "title": "Comment",
              "description": "One review comment.",
              "type": "object",
              "additionalProperties": false,
              "required": [
                "text"
              ],
              "properties": {
                "text": {
                  "title": "Text",
                  "description": "The comment.",
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 8000
                },
                "sheet": {
                  "title": "Sheet",
                  "description": "The plan sheet the comment refers to, for example A2.1.",
                  "type": "string",
                  "maxLength": 50
                },
                "codeSection": {
                  "title": "Code section",
                  "description": "The code section cited.",
                  "type": "string",
                  "maxLength": 100
                },
                "resolved": {
                  "title": "Resolved",
                  "description": "Whether the comment has been resolved.",
                  "type": "boolean"
                }
              }
            }
          }
        }
      }
    },
    "statutoryClock": {
      "title": "Statutory review clock",
      "description": "The time limit the law or ordinance sets for deciding the application, and its state. Many jurisdictions set review deadlines; the rules vary, so the record states the basis and the counting rule it applied.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "basis",
        "days",
        "dayType"
      ],
      "properties": {
        "basis": {
          "title": "Basis",
          "description": "The law, ordinance or policy that sets the deadline, as cited locally.",
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "days": {
          "title": "Days allowed",
          "description": "Days allowed for the decision.",
          "type": "integer",
          "minimum": 1
        },
        "dayType": {
          "title": "Day type",
          "description": "calendar or business days.",
          "type": "string",
          "enum": [
            "calendar",
            "business"
          ]
        },
        "startedAt": {
          "$ref": "common.schema.json#/$defs/dateTime",
          "description": "When it started."
        },
        "dueOn": {
          "$ref": "common.schema.json#/$defs/date",
          "description": "The date the decision is due under the basis, after pauses."
        },
        "pauses": {
          "title": "Pauses",
          "description": "Periods when the clock stopped, for example while waiting for the applicant.",
          "type": "array",
          "items": {
            "title": "Pause",
            "description": "One period when the clock stopped.",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "from",
              "reason"
            ],
            "properties": {
              "from": {
                "$ref": "common.schema.json#/$defs/dateTime",
                "description": "When the pause began."
              },
              "to": {
                "$ref": "common.schema.json#/$defs/dateTime",
                "description": "When the pause ended; leave out while it continues."
              },
              "reason": {
                "title": "Reason",
                "description": "awaiting-applicant, fees-outstanding, applicant-request, third-party-review or other.",
                "type": "string",
                "enum": [
                  "awaiting-applicant",
                  "fees-outstanding",
                  "applicant-request",
                  "third-party-review",
                  "other"
                ]
              }
            }
          }
        },
        "consequenceIfMissed": {
          "title": "Consequence if missed",
          "description": "What the basis says happens when the deadline passes: deemed-approved, fee-refund, escalation, none or unspecified.",
          "type": "string",
          "enum": [
            "deemed-approved",
            "fee-refund",
            "escalation",
            "none",
            "unspecified"
          ]
        }
      }
    },
    "inspections": {
      "title": "Inspections",
      "description": "Inspections of the permitted work.",
      "type": "array",
      "items": {
        "title": "Inspection",
        "description": "One inspection.",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "result"
        ],
        "properties": {
          "type": {
            "title": "Type",
            "description": "The inspection, as the jurisdiction names it, for example Footing or Final Electrical.",
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "requestedFor": {
            "$ref": "common.schema.json#/$defs/date",
            "description": "The date the inspection was requested for."
          },
          "scheduledFor": {
            "$ref": "common.schema.json#/$defs/dateTime",
            "description": "When the inspection is scheduled."
          },
          "inspector": {
            "$ref": "common.schema.json#/$defs/personRef",
            "description": "Who inspected."
          },
          "result": {
            "title": "Result",
            "description": "scheduled, passed, failed, partial, cancelled or no-access.",
            "type": "string",
            "enum": [
              "scheduled",
              "passed",
              "failed",
              "partial",
              "cancelled",
              "no-access"
            ]
          },
          "completedAt": {
            "$ref": "common.schema.json#/$defs/dateTime",
            "description": "When it was completed."
          },
          "notes": {
            "title": "Notes",
            "description": "The inspector's notes.",
            "type": "string",
            "maxLength": 8000
          }
        }
      }
    },
    "decision": {
      "title": "Decision",
      "description": "The jurisdiction's decision on the application.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "outcome",
        "decidedAt"
      ],
      "properties": {
        "outcome": {
          "title": "Outcome",
          "description": "issued, approved (approved but not yet issued, for example pending fees), denied, withdrawn, expired or revoked.",
          "type": "string",
          "enum": [
            "issued",
            "approved",
            "denied",
            "withdrawn",
            "expired",
            "revoked"
          ]
        },
        "decidedAt": {
          "$ref": "common.schema.json#/$defs/dateTime",
          "description": "When the decision was made."
        },
        "decidedBy": {
          "$ref": "common.schema.json#/$defs/personRef",
          "description": "Who decided."
        },
        "permitNumber": {
          "title": "Permit number",
          "description": "The number of the issued permit. Required when the outcome is issued.",
          "type": "string",
          "maxLength": 100
        },
        "conditions": {
          "title": "Conditions",
          "description": "Conditions of approval.",
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          }
        },
        "reasons": {
          "title": "Reasons",
          "description": "Reasons for a denial or revocation.",
          "type": "string",
          "maxLength": 8000
        },
        "expiresOn": {
          "$ref": "common.schema.json#/$defs/date",
          "description": "When it expires."
        },
        "appealDeadline": {
          "$ref": "common.schema.json#/$defs/date",
          "description": "Last day to file an appeal."
        }
      },
      "if": {
        "properties": {
          "outcome": {
            "const": "issued"
          }
        }
      },
      "then": {
        "required": [
          "permitNumber"
        ]
      }
    },
    "status": {
      "title": "Status",
      "description": "draft, submitted, intake-review, incomplete, in-review, corrections-required, approved, issued, under-inspection, finaled, denied, withdrawn or expired.",
      "type": "string",
      "enum": [
        "draft",
        "submitted",
        "intake-review",
        "incomplete",
        "in-review",
        "corrections-required",
        "approved",
        "issued",
        "under-inspection",
        "finaled",
        "denied",
        "withdrawn",
        "expired"
      ]
    },
    "statusHistory": {
      "title": "Status history",
      "description": "Every status the record has had, oldest first.",
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/statusChange"
      }
    },
    "attachments": {
      "title": "Attachments",
      "description": "Files that belong to the application: plans, calculations, photos, letters.",
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/attachment"
      }
    },
    "auditTrail": {
      "title": "Audit trail",
      "description": "Recorded actions on the application, oldest first.",
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/auditEntry"
      }
    },
    "extensions": {
      "$ref": "common.schema.json#/$defs/extensions",
      "description": "Local fields this format doesn't define, namespaced as <namespace>:<field>."
    }
  },
  "$defs": {
    "party": {
      "title": "Party",
      "description": "A person or organization on the application, in a role. Give a person, an organization, or both (a contact at a firm).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role"
      ],
      "anyOf": [
        {
          "required": [
            "person"
          ]
        },
        {
          "required": [
            "organization"
          ]
        }
      ],
      "properties": {
        "role": {
          "title": "Role",
          "description": "owner, applicant, contractor, architect, engineer, agent, tenant or other.",
          "type": "string",
          "enum": [
            "owner",
            "applicant",
            "contractor",
            "architect",
            "engineer",
            "agent",
            "tenant",
            "other"
          ]
        },
        "person": {
          "$ref": "common.schema.json#/$defs/personRef",
          "description": "The person."
        },
        "organization": {
          "$ref": "common.schema.json#/$defs/organizationRef",
          "description": "The organization."
        },
        "mailingAddress": {
          "$ref": "common.schema.json#/$defs/address",
          "description": "Where to send notices."
        },
        "license": {
          "title": "License",
          "description": "A professional or contractor license held by the party.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "number"
          ],
          "properties": {
            "number": {
              "title": "Number",
              "description": "The license number.",
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            "type": {
              "title": "Type",
              "description": "The license class, for example General Building Contractor.",
              "type": "string",
              "maxLength": 200
            },
            "issuer": {
              "title": "Issuer",
              "description": "The licensing board or agency.",
              "type": "string",
              "maxLength": 200
            },
            "expiresOn": {
              "$ref": "common.schema.json#/$defs/date",
              "description": "When it expires."
            }
          }
        }
      }
    }
  }
}
