{
  "name": "@moraph/regulated-workflow-schemas",
  "version": "0.1.0",
  "description": "Open JSON Schema record formats for regulated workflows: vendor risk reviews, patient safety incidents, permit applications and board actions. With a validator and TypeScript types.",
  "license": "Apache-2.0",
  "author": "Moraph (https://www.moraph.com)",
  "homepage": "https://github.com/moraph-com/regulated-workflow-schemas#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moraph-com/regulated-workflow-schemas.git"
  },
  "bugs": "https://github.com/moraph-com/regulated-workflow-schemas/issues",
  "keywords": [
    "json-schema",
    "third-party-risk",
    "vendor-risk",
    "patient-safety",
    "permitting",
    "govtech",
    "board-governance",
    "open-data",
    "regtech"
  ],
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./types": "./types/index.d.ts",
    "./schemas/*": "./schemas/*",
    "./package.json": "./package.json"
  },
  "bin": {
    "rws-validate": "./dist/cli.js"
  },
  "files": [
    "dist",
    "schemas",
    "types",
    "docs"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p types/tsconfig.json",
    "test": "npm run build && node --test test/*.test.mjs",
    "types": "node scripts/build-types.mjs",
    "types:check": "node scripts/build-types.mjs --check",
    "docs": "node scripts/build-docs.mjs",
    "docs:check": "node scripts/build-docs.mjs --check",
    "validate:examples": "npm run build && node dist/cli.js examples/*/valid-*.json",
    "prepublishOnly": "npm run typecheck && npm test && npm run types:check && npm run docs:check"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "json-schema-to-typescript": "^16.0.0",
    "typescript": "~7.0.2"
  }
}
